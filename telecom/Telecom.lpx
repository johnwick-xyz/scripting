#!name=中国电信 Cookie 抓取
#!desc=打开 e.dlife.cn 登录页或中国电信 App，把登录地址 / Cookie 写进 BoxJs，供 Scripting 中国电信小组件读取
#!author=MJ

[Script]
http-request ^https://e\.dlife\.cn/user/loginMiddle tag=电信登录地址, script-path=https://raw.githubusercontent.com/johnwick-xyz/scripting/main/telecom/TelecomGetLoginUrl.js, requires-body=false
http-request ^https://e\.dlife\.cn/ tag=电信Cookie, script-path=https://raw.githubusercontent.com/johnwick-xyz/scripting/main/telecom/TelecomGetCookie.js, requires-body=false

[MITM]
hostname = e.dlife.cn
