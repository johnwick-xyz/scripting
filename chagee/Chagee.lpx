#!name=霸王茶姬签到
#!desc=抓取霸王茶姬小程序的登录凭证与签到参数，每天 8:00 自动签到
#!author=MJ

[MITM]
hostname = *.qmai.cn, qmai.cn

[Script]
http-request ^https?://[^/]*\.qmai\.cn/ tag=霸王茶姬凭证抓取, script-path=https://raw.githubusercontent.com/johnwick-xyz/scripting/main/chagee/ChageeGetAuth.js, requires-body=true
http-response ^https?://[^/]*\.qmai\.cn/web/(cmk-center/sign/takePartInSign|catering/crm/personal-info|catering2-apiserver/v3/order/list) tag=霸王茶姬用户ID抓取, script-path=https://raw.githubusercontent.com/johnwick-xyz/scripting/main/chagee/ChageeGetUserId.js, requires-body=true
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/johnwick-xyz/scripting/main/chagee/ChageeSign.js, tag=霸王茶姬每日签到
